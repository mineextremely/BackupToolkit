{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://backuptoolkit.invalid/schema/format-v2.schema.json",
  "title": "BackupToolkit v2 backup manifest",
  "description": "单次备份 manifest.json 的机器可读 schema（草案）。规范解释见 docs/rea/09-格式v2规范.md。",
  "type": "object",
  "required": [
    "schema",
    "backupId",
    "status",
    "createdAt",
    "finishedAt",
    "tool",
    "package",
    "requestedKinds",
    "parts",
    "origin"
  ],
  "properties": {
    "schema": {
      "const": 2
    },
    "backupId": {
      "type": "string",
      "anyOf": [
        { "pattern": "^[0-9]{13}-[0-9a-f]{8}$" },
        { "pattern": "^[0-9]+$" },
        { "pattern": "^[0-9]{13}-v1[0-9a-f]{8}$" }
      ]
    },
    "status": {
      "enum": ["in_progress", "complete", "partial", "failed"]
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "finishedAt": {
      "type": ["string", "null"],
      "format": "date-time"
    },
    "tool": {
      "$ref": "#/$defs/tool"
    },
    "device": {
      "$ref": "#/$defs/device"
    },
    "package": {
      "$ref": "#/$defs/package"
    },
    "selinux": {
      "oneOf": [
        { "$ref": "#/$defs/selinux" },
        { "type": "null" }
      ]
    },
    "requestedModes": {
      "type": "array",
      "items": { "enum": ["apk", "user", "data"] },
      "uniqueItems": true
    },
    "requestedKinds": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/kind" },
      "uniqueItems": true
    },
    "skippedKinds": {
      "type": "array",
      "items": { "$ref": "#/$defs/skippedKind" }
    },
    "errors": {
      "type": "array",
      "items": { "$ref": "#/$defs/error" }
    },
    "parts": {
      "type": "array",
      "items": { "$ref": "#/$defs/part" }
    },
    "totals": {
      "$ref": "#/$defs/totals"
    },
    "note": {
      "type": ["string", "null"],
      "maxLength": 1024,
      "pattern": "^[^\\u0000-\\u001f\\u007f]*$"
    },
    "encryption": {
      "type": ["object", "null"]
    },
    "origin": {
      "$ref": "#/$defs/origin"
    },
    "compat": {
      "type": "object"
    }
  },
  "additionalProperties": true,
  "allOf": [
    {
      "if": {
        "properties": { "status": { "enum": ["complete", "partial", "failed"] } },
        "required": ["status"]
      },
      "then": {
        "required": ["finishedAt"],
        "properties": { "finishedAt": { "type": "string" } }
      }
    },
    {
      "if": {
        "properties": { "status": { "const": "in_progress" } },
        "required": ["status"]
      },
      "then": {
        "properties": { "finishedAt": { "type": "null" } }
      }
    },
    {
      "if": {
        "properties": {
          "origin": {
            "type": "object",
            "properties": { "format": { "const": "v2" } },
            "required": ["format"]
          }
        },
        "required": ["origin"]
      },
      "then": {
        "properties": {
          "package": {
            "type": "object",
            "required": ["userId", "appId"],
            "properties": {
              "userId": { "type": "integer" },
              "appId": { "type": "integer" }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": { "status": { "const": "partial" } },
        "required": ["status"]
      },
      "then": {
        "properties": { "parts": { "type": "array", "minItems": 1 } }
      }
    },
    {
      "if": {
        "properties": {
          "origin": {
            "type": "object",
            "properties": { "format": { "const": "v1" } },
            "required": ["format"]
          }
        },
        "required": ["origin"]
      },
      "then": {
        "properties": {
          "origin": {
            "type": "object",
            "properties": {
              "layout": { "enum": ["appdir", "flat"] },
              "metadataPath": { "type": "string" },
              "sourceKey": { "type": "string" }
            },
            "required": ["layout", "metadataPath", "sourceKey"]
          }
        }
      }
    }
  ],
  "$defs": {
    "kind": {
      "enum": [
        "package",
        "apk_obb",
        "internal_data",
        "internal_device_protected",
        "external_data",
        "external_media",
        "external_files"
      ]
    },
    "compression": {
      "enum": ["none", "zstd", "gzip", "xz", "lz4"]
    },
    "tool": {
      "type": "object",
      "required": ["name", "version", "versionCode"],
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 64 },
        "version": { "type": "string", "minLength": 1, "maxLength": 32 },
        "versionCode": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": true
    },
    "device": {
      "type": "object",
      "properties": {
        "sdk": { "type": "integer", "minimum": 1 },
        "abi": { "type": "string" },
        "manufacturer": { "type": "string" },
        "model": { "type": "string" },
        "buildFingerprint": { "type": "string" }
      },
      "additionalProperties": true
    },
    "package": {
      "type": "object",
      "required": ["name"],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_]*(\\.[A-Za-z][A-Za-z0-9_]*)+$"
        },
        "label": {
          "type": ["string", "null"],
          "maxLength": 256,
          "pattern": "^[^\\u0000-\\u001f\\u007f]*$"
        },
        "versionName": { "type": ["string", "null"] },
        "versionCode": { "type": "integer", "minimum": 0 },
        "userId": { "type": ["integer", "null"], "minimum": 0 },
        "userSerial": { "type": ["integer", "null"], "minimum": 0 },
        "appId": { "type": ["integer", "null"], "minimum": 0, "maximum": 99999 },
        "uid": { "type": ["integer", "null"], "minimum": 0 },
        "signerSha256": {
          "type": ["string", "null"],
          "pattern": "^[0-9a-f]{64}$"
        },
        "isSystem": { "type": "boolean" }
      },
      "additionalProperties": true
    },
    "selinux": {
      "type": "object",
      "properties": {
        "dataType": { "type": ["string", "null"] },
        "dataContext": { "type": ["string", "null"] },
        "externalDataType": { "type": ["string", "null"] }
      },
      "additionalProperties": true
    },
    "skippedKind": {
      "type": "object",
      "required": ["kind", "reason"],
      "properties": {
        "kind": { "$ref": "#/$defs/kind" },
        "reason": { "enum": ["absent", "not_selected", "unsupported"] }
      },
      "additionalProperties": true
    },
    "error": {
      "type": "object",
      "required": ["code", "at"],
      "properties": {
        "kind": { "$ref": "#/$defs/kind" },
        "code": { "type": "string", "pattern": "^[EW]_[A-Z0-9_]+$" },
        "message": { "type": "string" },
        "at": { "type": "string", "format": "date-time" }
      },
      "additionalProperties": true
    },
    "part": {
      "type": "object",
      "required": ["kind", "file", "compression", "sizeBytes", "sha256"],
      "properties": {
        "kind": { "$ref": "#/$defs/kind" },
        "file": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]+\\.tar(?:\\.(?:zst|gz|xz|lz4))?$"
        },
        "compression": { "$ref": "#/$defs/compression" },
        "level": { "type": ["integer", "null"], "minimum": 1, "maximum": 19 },
        "sizeBytes": { "type": "integer", "minimum": 1 },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "entryCount": { "type": "integer", "minimum": 0 },
        "uncompressedBytes": { "type": "integer", "minimum": 0 },
        "sourcePath": { "type": "string" },
        "excludes": { "type": "array", "items": { "type": "string" } },
        "seq": { "type": "integer", "minimum": 0 },
        "plaintextSha256": {
          "type": ["string", "null"],
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "allOf": [
        {
          "if": { "properties": { "compression": { "const": "zstd" } }, "required": ["compression"] },
          "then": {
            "required": ["level"],
            "properties": { "level": { "type": "integer", "minimum": 1, "maximum": 19 } }
          }
        },
        {
          "if": {
            "properties": { "compression": { "enum": ["none", "gzip", "xz", "lz4"] } },
            "required": ["compression"]
          },
          "then": { "properties": { "level": { "type": "null" } } }
        },
        {
          "if": { "properties": { "kind": { "const": "package" } }, "required": ["kind"] },
          "then": { "properties": { "file": { "type": "string", "pattern": "^package\\.tar(?:\\.(?:zst|gz|xz|lz4))?$" } } }
        },
        {
          "if": { "properties": { "kind": { "const": "apk_obb" } }, "required": ["kind"] },
          "then": { "properties": { "file": { "type": "string", "pattern": "^apk_obb\\.tar(?:\\.(?:zst|gz|xz|lz4))?$" } } }
        },
        {
          "if": { "properties": { "kind": { "const": "internal_data" } }, "required": ["kind"] },
          "then": { "properties": { "file": { "type": "string", "pattern": "^internal_data\\.tar(?:\\.(?:zst|gz|xz|lz4))?$" } } }
        },
        {
          "if": { "properties": { "kind": { "const": "internal_device_protected" } }, "required": ["kind"] },
          "then": { "properties": { "file": { "type": "string", "pattern": "^internal_device_protected\\.tar(?:\\.(?:zst|gz|xz|lz4))?$" } } }
        },
        {
          "if": { "properties": { "kind": { "const": "external_data" } }, "required": ["kind"] },
          "then": { "properties": { "file": { "type": "string", "pattern": "^external_data\\.tar(?:\\.(?:zst|gz|xz|lz4))?$" } } }
        },
        {
          "if": { "properties": { "kind": { "const": "external_media" } }, "required": ["kind"] },
          "then": { "properties": { "file": { "type": "string", "pattern": "^external_media\\.tar(?:\\.(?:zst|gz|xz|lz4))?$" } } }
        },
        {
          "if": { "properties": { "kind": { "const": "external_files" } }, "required": ["kind"] },
          "then": { "properties": { "file": { "type": "string", "pattern": "^external_files\\.tar(?:\\.(?:zst|gz|xz|lz4))?$" } } }
        }
      ],
      "additionalProperties": true
    },
    "totals": {
      "type": "object",
      "properties": {
        "sizeBytes": { "type": "integer", "minimum": 0 },
        "uncompressedBytes": { "type": ["integer", "null"], "minimum": 0 },
        "partCount": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": true
    },
    "origin": {
      "type": "object",
      "required": ["format"],
      "properties": {
        "format": { "enum": ["v1", "v2"] },
        "layout": { "enum": ["appdir", "flat"] },
        "metadataPath": { "type": "string" },
        "sourceKey": { "type": "string" }
      },
      "additionalProperties": true
    }
  }
}
